import { createApp } from 'vue';
import FormacionAcademica from './components/FormacionAcademica.vue';

const contenedor = document.getElementById('vue-formacion-academica');

if (contenedor) {
    const instituciones = JSON.parse(
        contenedor.dataset.instituciones || '[]'
    );

    const formacion = JSON.parse(
        contenedor.dataset.formacion || '{}'
    );

    createApp(FormacionAcademica, {
        instituciones,
        formacion
    }).mount(contenedor);
}

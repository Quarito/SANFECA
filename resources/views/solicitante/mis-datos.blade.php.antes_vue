<script>
function mostrarFormularioDatos() {
    document.getElementById('formulario-actualizacion').style.display = 'block';
    document.getElementById('btn-modificar-datos').style.display = 'none';
}

function ocultarFormularioDatos() {
    document.getElementById('formulario-actualizacion').style.display = 'none';
    document.getElementById('btn-modificar-datos').style.display = 'inline-block';
}
</script>


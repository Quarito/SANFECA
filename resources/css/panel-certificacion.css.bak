
.cert-layout {
    display: flex;
    min-height: calc(100vh - 90px);
    background: #f6f8fb;
}

.cert-sidebar {
    width: 250px;
    min-width: 250px;
    padding: 22px 14px;
    background: #151d2e;
    color: #ffffff;
}

.cert-sidebar-title {
    margin-bottom: 22px;
    padding: 0 8px;
    font-size: 15px;
    font-weight: 600;
}

.cert-sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 9px;
}

.cert-sidebar-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 12px;
    border: 1px solid #303a4c;
    border-radius: 7px;
    background: #1c2637;
    color: #c6cfdd;
    text-decoration: none;
    transition: background .2s;
}

.cert-sidebar-item:hover {
    background: #29384d;
    color: white;
}

.cert-sidebar-item.active {
    border-left: 3px solid #d7a72d;
    background: #29384d;
    color: white;
}

.cert-sidebar-item.unavailable {
    opacity: .55;
    cursor: not-allowed;
}

.cert-step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #40516c;
    color: white;
    font-size: 12px;
}

.cert-step-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.cert-step-text strong {
    font-size: 12px;
}

.cert-step-text small {
    font-size: 10px;
}

.cert-main {
    flex: 1;
    min-width: 0;
    padding: 25px;
}

@media (max-width: 768px) {
    .cert-layout {
        flex-direction: column;
    }

    .cert-sidebar {
        width: 100%;
        min-width: 0;
    }

    .cert-main {
        padding: 15px;
    }
}
/* PANEL LATERAL HOMOLOGADO CON ANFECA */

.cert-layout {
    display: flex;
    align-items: stretch;
    gap: 0;
    background: #ffffff;
}

.cert-sidebar {
    width: 250px;
    min-width: 250px;
    padding: 24px 14px;
    background: #f4f5f7;
    color: #333333;
    border-right: 1px solid #dedede;
}

.cert-sidebar-title {
    color: #333333;
    font-size: 15px;
    font-weight: 700;
    padding-bottom: 14px;
    border-bottom: 2px solid #a68a55;
}

.cert-sidebar-item {
    background: #ffffff;
    color: #444444;
    border: 1px solid #dedede;
    border-radius: 5px;
}

.cert-sidebar-item:hover {
    background: #f0ebe2;
    color: #333333;
}

.cert-sidebar-item.active {
    background: #f0ebe2;
    border: 1px solid #a68a55;
    border-left: 4px solid #a68a55;
    color: #333333;
}

.cert-step-number {
    background: #a68a55;
    color: #ffffff;
}

.cert-step-text strong {
    color: inherit;
}

.cert-step-text small {
    color: #777777;
}

.cert-sidebar-item.unavailable {
    background: #f5f5f5;
    opacity: 0.65;
}

.cert-main {
    flex: 1;
    min-width: 0;
    padding: 25px;
    background: #ffffff;
}

@media (max-width: 768px) {
    .cert-layout {
        flex-direction: column;
    }

    .cert-sidebar {
        width: 100%;
        min-width: 0;
        border-right: none;
        border-bottom: 1px solid #dedede;
    }

    .cert-main {
        padding: 15px;
    }
}

*.bak
*.bak_*
*.antes_panel
*.antes_centrado
/respaldos/
.gitignore.respaldo_local

# Archivos de desarrollo
.DS_Store
.phpactor.json
.phpunit.result.cache
/.phpunit.cache/
/.codex/
/.cursor/
/.idea/
/nova/
/.vscode/
/.zed/
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Archivos de registro
*.log

# Archivos temporales pendientes de revision
/0
/[
/sin_vinculacion

# Volcados de base de datos y capturas: nunca en el repositorio (contienen datos personales)
*.dump
*.sql.gz
/respaldos_demo/
/respaldos_usuario_k/
/:USERPROFILE*

# Protección adicional: nunca versionar documentos, logs ni temporales de storage,
# aunque falte algún .gitignore interno.
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore

# Python
__pycache__/
*.pyc

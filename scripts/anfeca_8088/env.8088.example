# ANFECA · ambiente 8088 (36 tablas oficiales). Copiar a /var/www/ANFECA_8088/.env y completar los secretos
# en el servidor (nunca en Git). Sesiones, caché y colas NO usan la base institucional.
APP_NAME=ANFECA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.7.130:8088
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Instancia PostgreSQL 18.6 EXCLUSIVA del 8088 (no la del 8086).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5488
DB_DATABASE=certificacion_anfeca
DB_SEARCH_PATH=public
DB_USERNAME=anfeca_8088
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null
FILESYSTEM_DISK=local
ANFECA_DISCO_EXPEDIENTES=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@anfeca.example"
MAIL_FROM_NAME="${APP_NAME}"

# Banderas funcionales vigentes en 8086 (mismo comportamiento visual). Los catálogos ANUIES se copian desde
# 8086 (storage/app/private/catalogos/) con su SHA-256 y versión; sin ellos las pantallas usan el formulario anterior.
ANFECA_CATALOGO_LICENCIATURAS=true
ANFECA_CATALOGO_LICENCIATURAS_SHA256=
ANFECA_CATALOGO_LICENCIATURAS_VERSION=
ANFECA_CATALOGO_POSGRADOS=true
ANFECA_CATALOGO_POSGRADOS_SHA256=
ANFECA_CATALOGO_POSGRADOS_VERSION=
ANFECA_DECLARACION_POSGRADO=true
ANFECA_COORDINACION_REVISION=false

# ANFECA · ambiente 8090 (integración definitiva). Copiar a /var/www/ANFECA_8090/.env y completar los secretos EN EL
# SERVIDOR (nunca en Git). Sesiones, caché y colas en archivos: no requieren tablas adicionales.
APP_NAME=ANFECA
APP_ENV=production
APP_DEBUG=false
APP_URL=http://IP_SERVIDOR:8090
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Copia independiente certificacion_anfeca_8090 (restaurada en 10.2) con su propio rol; nunca la base de 8088.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5488
DB_DATABASE=certificacion_anfeca_8090
DB_SEARCH_PATH=public
DB_USERNAME=anfeca_8090
DB_PASSWORD=

# Sesión independiente: cookie propia (no se comparte con 8086/8088 en el mismo servidor).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=anfeca_8090_session
CACHE_STORE=file
CACHE_PREFIX=anfeca_8090
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null
FILESYSTEM_DISK=local
ANFECA_DISCO_EXPEDIENTES=local

# Ningún correo sale del servidor durante la validación: se escriben en el log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@anfeca.example"
MAIL_FROM_NAME="${APP_NAME}"

# Catálogos ANUIES: la Fase 10 usa la información ya cargada en PostgreSQL (estudio_profesional); los JSON quedan
# desactivados hasta completar la búsqueda directa (Fase 10.8).
ANFECA_CATALOGO_LICENCIATURAS=false
ANFECA_CATALOGO_POSGRADOS=false
ANFECA_DECLARACION_POSGRADO=true
ANFECA_COORDINACION_REVISION=false

[Unit]
Description=PostgreSQL 18.6 exclusivo de ANFECA 8088
After=systemd-tmpfiles-setup.service

[Service]
Type=exec
User=postgres
Group=postgres
ExecStart=/usr/pgsql-18/bin/postgres -D /var/lib/pgsql/anfeca8088 -p 55488 -c listen_addresses= -c unix_socket_directories=/run/anfeca8088-pg -c hba_file=/etc/anfeca8088/pg_hba.conf
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pgsql/anfeca8088 /run/anfeca8088-pg
PrivateTmp=true

[Install]
WantedBy=multi-user.target

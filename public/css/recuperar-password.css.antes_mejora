
html, body {
    margin: 0;
    min-height: 100%;
}

.pagina-recuperacion {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

.contenido-recuperacion {
    flex: 1;
    padding: 38px 5% 25px;
}

.formulario-recuperacion {
    width: 100%;
}

.recuperacion-formulario {
    max-width: 330px;
    margin: 0 auto;
    text-align: center;
}

.recuperacion-formulario h2 {
    font-size: 15px;
    font-weight: bold;
    border-bottom: 1px solid #888;
    padding-bottom: 5px;
    margin: 0 0 12px;
}

.campo-recuperacion {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 20px;
}

.campo-recuperacion label {
    font-size: 12px;
}

.campo-recuperacion input {
    width: 230px;
    max-width: 100%;
    min-height: 25px;
    border: 1px solid #888;
    border-radius: 4px;
    padding: 4px 8px;
    box-sizing: border-box;
    font-size: 13px;
}

.nota-recuperacion {
    margin: 26px auto 0;
    max-width: 330px;
    font-size: 12px;
    line-height: 1.35;
}

.nota-recuperacion strong {
    color: #990d17;
}

.botones-recuperacion {
    display: flex;
    justify-content: space-between;
    margin-top: 38px;
    gap: 20px;
}

.boton-rojo {
    background: #990d17;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 7px 20px;
    min-width: 115px;
    font-size: 12px;
    font-weight: bold;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    box-sizing: border-box;
}

.boton-rojo:hover {
    background: #760a12;
    color: white;
}

.mensaje-recuperacion,
.errores-recuperacion {
    max-width: 500px;
    margin: 0 auto 18px;
    padding: 12px;
    border: 1px solid #aaa;
    border-radius: 6px;
    font-size: 13px;
    text-align: center;
}

.errores-recuperacion {
    color: #990d17;
}

@media (max-width: 600px) {
    .contenido-recuperacion {
        padding: 30px 20px;
    }

    .botones-recuperacion {
        margin-top: 35px;
    }
}
/* Confirmación de recuperación de contraseña */

.tarjeta-confirmacion {
    width: min(100%, 520px);
    box-sizing: border-box;
    margin: 45px auto;
    padding: 35px 30px;
    background: #ffffff;
    border: 1px solid #ead6d9;
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
}

.confirmacion-icono {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: #f9e8e9;
    color: #bd2434;
    font-size: 30px;
    font-weight: bold;
}

.tarjeta-confirmacion h2 {
    margin-bottom: 20px;
    color: #bd2434;
    font-size: 23px;
}

.tarjeta-confirmacion p {
    margin-bottom: 18px;
    color: #39434e;
    font-size: 14px;
    line-height: 1.7;
}

.tarjeta-confirmacion .botones-recuperacion {
    display: flex;
    justify-content: center;
    margin-top: 25px;
}

@media (max-width: 600px) {
    .tarjeta-confirmacion {
        margin: 25px auto;
        padding: 25px 18px;
    }

